{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "v-dates",
  "position": {
    "x": 0,
    "y": 0,
    "z": 0,
    "width": 640,
    "height": 300
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "HierarchyLevel": {
                  "Expression": {
                    "Hierarchy": {
                      "Expression": {
                        "PropertyVariationSource": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "Sales"
                            }
                          },
                          "Name": "Variation",
                          "Property": "Order Date"
                        }
                      },
                      "Hierarchy": "Date Hierarchy"
                    }
                  },
                  "Level": "Year"
                }
              },
              "queryRef": "Sales.Order Date.Variation.Date Hierarchy.Year"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Total Amount"
                }
              },
              "queryRef": "Sales.Total Amount"
            }
          ]
        }
      }
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "visual-filter-unknown-alias",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Source": "missing-alias"
              }
            },
            "Property": "Region"
          }
        },
        "type": "Categorical"
      }
    ]
  }
}
